{
  "name": "witness-recorder",
  "version": "0.7.0",
  "mcpName": "io.github.wookat/witness",
  "repository": {
    "type": "git",
    "url": "https://github.com/wookat/witness"
  },
  "keywords": [
    "qa",
    "evidence",
    "ai-agents",
    "playwright",
    "mcp",
    "voice",
    "bug-report"
  ],
  "description": "Voice-anchored causal evidence recorder for AI coding agents. Talk, point, get an evidence packet your agent can act on.",
  "type": "module",
  "bin": {
    "wit": "dist/cli.js",
    "rec": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "local-asr",
    "README*.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test test/core.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.1.0",
    "dotenv": "^16.4.5",
    "openai": "^7.55.0",
    "playwright": "^1.65.0",
    "rrweb": "^2.2.2",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "author": "zalize (https://github.com/wookat)"
}
