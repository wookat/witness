{
  "name": "witness-recorder",
  "version": "0.4.0",
  "mcpName": "io.github.wookat/witness",
  "repository": {
    "type": "git",
    "url": "https://github.com/wookat/witness"
  },
  "keywords": [
    "qa",
    "evidence",
    "ai-agents",
    "playwright",
    "mcp",
    "voice",
    "bug-report"
  ],
  "description": "Voice-anchored causal evidence recorder for AI coding agents. Talk, point, get an evidence packet your agent can act on.",
  "type": "module",
  "bin": {
    "wit": "dist/cli.js",
    "rec": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "README*.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test \"test/**/*.test.mjs\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "fix-webm-duration": "^1.0.6",
    "openai": "^4.77.0",
    "playwright": "^1.48.0",
    "rrweb": "^2.2.2",
    "ws": "^8.22.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.6.3"
  },
  "license": "MIT",
  "author": "zalize (https://github.com/wookat)"
}
