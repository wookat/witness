---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Ticker from "../components/Ticker.astro";
import Card from "../components/Card.astro";
import Term from "../components/Term.astro";
import Demo from "../components/Demo.astro";
import VideoDemo from "../components/VideoDemo.astro";
import Flow from "../components/Flow.astro";
import AudSplit from "../components/AudSplit.astro";
const GH = "https://github.com/wookat/witness";

const zhSays = [
  { t: "00:09", quote: "这个按钮滚动的时候会收缩变淡",
    ev: [["SCROLL","y=3936","dim"],["MUT","button.feedback · data-collapsed: false → true","acc2"],["MUT","button.feedback · data-collapsed: true → false","acc2"]],
    note: "属性在边界处来回抖动", ui: "scroll" },
  { t: "00:34", quote: "这个提交按钮点了没反应",
    ev: [["CLICK","button#submit “提交” · @482,701","ok"]],
    note: "点击后 1.8s 页面无任何反应——这本身就是证据", ui: "btn" },
  { t: "01:02", quote: "订单接口返回的数据不对",
    ev: [["CLICK","a[href=\"/orders\"] “订单”","ok"],["NET →","GET /api/orders?page=1","dim"],["NET ←","200 /api/orders · items: []","bad"]],
    note: "响应体已捕获 → bodies/req_0041.json", ui: "api" },
];
---
<Base lang="zh" title="Witness — 语音锚定的因果证据记录仪，为 AI 编码 agent 设计">
<Hero lang="zh" />

<div class="ruler"><b class="a">00:00</b><b class="b">REC</b><i style="--x:12%"></i></div>

<section class="alt"><div class="wrap center">
  <div class="kicker">01 · 问题</div>
  <h2 class="rv">Agent 看不到你眼睛看到的。</h2>
  <p class="lede rv" data-d="100">人一眼就能注意到"这个按钮滚动时收缩得很奇怪"，但把这个感受写给 AI agent，要十分钟截图、圈元素、组织 prompt——写出来的东西还是丢掉了<i>为什么</i>。说话是最便宜的标注通道，只是从来没有人给它做过记录仪。</p>
</div></section>

<div class="ruler"><b class="a">00:18</b><i style="--x:34%"></i></div>

<section><div class="wrap">
  <div class="kicker">02 · 实录</div>
  <h2 class="rv">一次点击，全部后果归档。</h2>
  <p class="lede rv" data-d="80">这是一段真实录制——说话、标记、点了没反应的按钮、保存。下面的 Pay 按钮点了<b>什么都没发生</b>，而这个"没有发生"被如实记为证据。</p>
  <div style="margin-top:52px"><VideoDemo lang="zh" /></div>
</div></section>

<div class="stats">
  <div class="stat"><b>3</b><span>条记录线</span></div>
  <div class="stat"><b>10</b><span>个 MCP 工具</span></div>
  <div class="stat"><b>0</b><span>云端 key 依赖</span></div>
  <div class="stat"><b>17</b><span>项测试通过</span></div>
  <div class="stat"><b>MIT</b><span>开源协议</span></div>
</div>

<section id="how" class="alt"><div class="wrap">
  <div class="kicker">03 · 工作原理</div>
  <h2 class="rv">三条记录线，一条时间轴。</h2>
  <p class="lede rv" data-d="80"><code>wit start &lt;dev-url&gt;</code> 打开一个托管浏览器。从那一刻起三条流并行记录——零手动：</p>
  <div class="grid g3">
    <Card icon="mic" n="01 / 语音" title="你说的话" d="0">全程录音 + 实时转写。想到什么说什么——一段话可以报多个问题，不用切分不用打断。</Card>
    <Card icon="zap" n="02 / 操作" title="操作 + 因果爆发链" d="80">每次点击捕获随后 ~1.8s 的后果：请求、响应、console 报错、DOM 变化。点击后什么都没发生，本身就是证据。</Card>
    <Card icon="layers" n="03 / 状态" title="页面演变" d="160">rrweb 全量 DOM 回放 + 事件驱动截图 + 周期 DOM 快照。任何一秒的页面状态都能倒回去看。</Card>
  </div>
  <Flow steps={[["wit start","<url>",true],["浏览 + 说话","",false],["Ctrl+点 / M 标记","",false],["■ 停止","",false],["证据包","",true]]} />
</div></section>

<div class="ruler"><b class="a">01:12</b><i style="--x:71%"></i></div>

<section id="evidence"><div class="wrap">
  <div class="kicker">04 · 产出</div>
  <h2 class="rv">你的话，变成证据锚点。</h2>
  <p class="lede rv" data-d="80">每段语音成为时间轴上的一个块，挂载该时刻的因果事实——"因果爆发链"。点开一句话看看：</p>
  <Demo says={zhSays} hint="点击一句话展开它的证据" />
</div></section>

<div class="ruler"><b class="a">01:48</b><b class="b">SAY ×3</b><i style="--x:82%"></i></div>

<section class="alt"><div class="wrap">
  <div class="kicker">05 · 两种受众</div>
  <h2 class="rv">人看回放，Agent 读结构。</h2>
  <AudSplit
    labels={["给人看","给 AI agent"]}
    humans={[["review.html","语音卡片 + 音频跳转 + 截图"],["▶ DOM 回放","内嵌 rrweb 播放器，真实页面状态"],["胶片条","像视频一样拖扫整段会话"],["audio.webm","原始录音"]]}
    agents={[["PROMPT.md","交接说明 + 页面词表"],["session.md","上面的证据时间轴"],["events.jsonl","全量原始事件流，崩溃安全"],["dom/ · bodies/ · shots/","DOM 快照、请求体、截图帧"]]} />
</div></section>

<section id="mcp"><div class="wrap">
  <div class="kicker">06 · 拉取，不是推送</div>
  <h2 class="rv"><code>wit mcp</code>——把证据变成 API。</h2>
  <p class="lede rv" data-d="80">session 不是一坨死文件，而是一个 stdio MCP server。接进任何支持 MCP 的 agent，它按需查询精确的证据：</p>
  <div class="grid g3">
    <Card icon="file" d="0"><span slot="title"><code>list_says</code></span>全部语音片段 + 时间戳——问题锚点。</Card>
    <Card icon="clock" d="40"><span slot="title"><code>events_around</code></span>按时间窗+类型过滤的原始事件。</Card>
    <Card icon="layers" d="80"><span slot="title"><code>get_dom_state</code></span>离某个时间点最近的完整 DOM。</Card>
    <Card icon="zap" d="0"><span slot="title"><code>get_errors</code></span>console 报错、页面异常、HTTP ≥400。</Card>
    <Card icon="box" d="40"><span slot="title"><code>get_shot / get_body</code></span>按需取截图帧和响应体。</Card>
    <Card icon="api" d="80"><span slot="title"><code>session_md</code></span>要全文时返回渲染好的时间轴。</Card>
    <Card icon="mic" d="100"><span slot="title"><code>get_asr / set_asr</code></span>agent 自己查、自己切语音引擎——配置环里不需要人。</Card>
  </div>
</div></section>

<div class="ruler"><b class="a">02:31</b><b class="b">STOP ■</b><i style="--x:94%"></i></div>

<section class="alt"><div class="wrap">
  <div class="kicker">07 · 原则</div>
  <h2 class="rv">证据不说谎。</h2>
  <div class="grid g2">
    <Card icon="terminal" title="本地优先，零配置" d="0">系统 Edge/Chrome + 免费流式 ASR（doubao-web → doubao-ime → 浏览器 SR 兜底，<code>wit config asr</code> 可切）。不需要任何 API key；LLM 只是可选增强层，永远不是主流程。</Card>
    <Card icon="file" title="原话不改写" d="80">你的语音逐字落进 events.jsonl。合并、纠错、语义关联都只是展示层建议——原始证词永远可审计。</Card>
    <Card icon="eye" title="证据 ≠ 意图" d="0">点击和滚动是事实不是抱怨。没有语音锚点时，明确告诉 agent：永远不要从行为推断 bug。</Card>
    <Card icon="shield" title="隐私工程化" d="80">密码字段四通道打码；POST 体自动脱敏凭证字段；P 暂停期全部冻结包括麦克风；敏感应用可用 <code>WIT_NO_BODIES</code>。</Card>
  </div>
</div></section>

<section id="install"><div class="wrap">
  <div class="kicker">08 · 上手</div>
  <h2 class="rv">三句话，跑通整个闭环。</h2>
  <p class="lede rv" data-d="60">你下指令，<b>agent 敲命令</b>。Witness 本体是 CLI（<code>wit</code>）——agent 驱动它开托管浏览器录制，结束后产出本地证据包：人看 <code>review.html</code>，agent 走 <code>session.md</code>/<code>PROMPT.md</code>/<code>wit mcp</code>。Node 18+、系统 Edge/Chrome、不上云、不要 key。</p>
  <Term label="你 → 你的 agent" d="100"><span class="c-say">你</span>    → "安装 witness"
<span class="c-ok">agent</span> → <span class="c-dim">npm i -g github:wookat/witness  ✓</span>
<span class="c-say">你</span>    → "帮我录一段 http://localhost:5173"
<span class="c-ok">agent</span> → <span class="c-dim">wit start  ✓ 受管浏览器弹出</span>
<span class="c-say">你</span>    → <span class="c-dim">正常使用产品，看到什么说什么，标记问题 —— 点 ■</span>
<span class="c-say">你</span>    → "按刚才录的把问题修了"
<span class="c-ok">agent</span> → <span class="c-dim">读 session.md → 修复 → 引用证据点汇报</span></Term>
  <div class="cta rv" data-d="160" style="display:flex;gap:12px;margin-top:30px">
    <a class="btn pri" href={GH}>★ 去 GitHub 点 Star<svg class="ar" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    <a class="btn" href="/zh/docs">读使用文档 ↗</a>
    <a class="btn" href={GH + "/blob/main/VISION.md"}>读愿景文档 ↗</a>
  </div>
</div></section>
</Base>
