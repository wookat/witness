---
const GH = "https://github.com/wookat/witness";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Witness — voice-anchored evidence recorder for AI coding agents</title>
<meta name="description" content="Talk, point, ship the fix. Witness records your voice, clicks, network, errors and DOM replay while you use a product — then hands your AI agent a causal evidence package it can act on.">
<meta property="og:title" content="Witness — your voice, welded to the evidence">
<meta property="og:description" content="Say what's wrong, point at it, keep going. One recording → a causal evidence package your AI coding agent can fix from.">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%23101114'/><circle cx='16' cy='14' r='6' fill='%23ff5147'/><rect x='13' y='22' width='6' height='3' rx='1.5' fill='%23fff'/></svg>">
<style>
  :root{
    --bg:#0b0c0f; --panel:#111318; --line:#23262e; --text:#e8eaf0; --dim:#9aa1ad;
    --acc:#ff5147; --acc2:#4a5cc4; --mono:ui-monospace,"SF Mono","Cascadia Code",Consolas,monospace;
  }
  *{box-sizing:border-box;margin:0}
  html{scroll-behavior:smooth}
  body{background:var(--bg);color:var(--text);font:16px/1.7 -apple-system,"Segoe UI",Inter,"Helvetica Neue",sans-serif;-webkit-font-smoothing:antialiased}
  .wrap{max-width:960px;margin:0 auto;padding:0 24px}
  a{color:inherit}
  code,pre{font-family:var(--mono)}
  ::selection{background:#ff514733}

  nav{position:sticky;top:0;z-index:10;background:#0b0c0fd9;backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
  nav .wrap{display:flex;align-items:center;gap:24px;height:56px}
  .logo{display:flex;align-items:center;gap:9px;font-weight:650;font-size:15px;text-decoration:none}
  .logo svg{width:20px;height:20px}
  nav .links{margin-left:auto;display:flex;gap:18px;font-size:13.5px}
  nav .links a{color:var(--dim);text-decoration:none}
  nav .links a:hover{color:var(--text)}
  nav .gh{border:1px solid var(--line);border-radius:6px;padding:4px 12px;color:var(--text)!important}

  header.hero{padding:96px 0 72px;text-align:center}
  .pill{display:inline-block;font:11px var(--mono);color:var(--dim);border:1px solid var(--line);border-radius:999px;padding:4px 14px;letter-spacing:.08em;margin-bottom:26px}
  h1{font-size:clamp(40px,7vw,68px);line-height:1.08;font-weight:700;letter-spacing:-.02em}
  h1 em{font-style:normal;color:var(--acc)}
  .sub{max-width:640px;margin:22px auto 0;color:var(--dim);font-size:18px}
  .install{display:inline-flex;align-items:center;gap:12px;margin-top:34px;background:var(--panel);border:1px solid var(--line);border-radius:9px;padding:12px 18px;font:14px var(--mono);color:#cfd3dc}
  .install b{color:#7ee787;font-weight:600}
  .install button{background:none;border:0;color:var(--dim);cursor:pointer;font:inherit;font-size:16px}
  .cta{display:flex;gap:12px;justify-content:center;margin-top:26px}
  .btn{display:inline-block;text-decoration:none;font-size:14px;font-weight:600;padding:10px 22px;border-radius:8px;border:1px solid var(--line);color:var(--dim)}
  .btn:hover{border-color:#3a3f4c;color:var(--text)}
  .btn.pri{background:var(--text);color:#0b0c0f;border-color:var(--text)}
  .btn.pri:hover{background:#fff}

  section{padding:64px 0;border-top:1px solid var(--line)}
  .kicker{font:11px var(--mono);letter-spacing:.14em;color:var(--acc);text-transform:uppercase;margin-bottom:14px}
  h2{font-size:clamp(26px,4vw,36px);font-weight:700;letter-spacing:-.01em;line-height:1.2;margin-bottom:14px}
  .lede{color:var(--dim);max-width:640px;font-size:16.5px}

  .grid{display:grid;gap:14px;margin-top:36px}
  .g3{grid-template-columns:repeat(3,1fr)}
  .g2{grid-template-columns:repeat(2,1fr)}
  @media(max-width:760px){.g3,.g2{grid-template-columns:1fr}}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:22px}
  .card h3{font-size:15.5px;font-weight:650;margin-bottom:8px}
  .card p{font-size:14px;color:var(--dim)}
  .card .n{font:12px var(--mono);color:var(--acc)}
  .card code{background:#0b0c0f;border:1px solid var(--line);border-radius:4px;padding:1px 6px;font-size:12.5px}

  .term{background:#0d0f13;border:1px solid var(--line);border-radius:12px;overflow:hidden;margin-top:36px;font:13px/1.8 var(--mono)}
  .term .th{display:flex;gap:7px;padding:11px 15px;border-bottom:1px solid var(--line);color:var(--dim);font-size:11.5px}
  .term .th i{width:10px;height:10px;border-radius:50%;background:#2c3038;display:inline-block}
  .term pre{padding:18px 20px;overflow-x:auto;color:#c9d0dc}
  .c-say{color:#8fb0ff}.c-ok{color:#7ee787}.c-bad{color:#ff7b72}.c-dim{color:#5f6673}.c-acc{color:#ffd66e}

  .split{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:36px}
  @media(max-width:760px){.split{grid-template-columns:1fr}}
  .aud h4{font:12px var(--mono);letter-spacing:.1em;color:var(--acc2);margin-bottom:12px;text-transform:uppercase}
  .aud.h h4{color:var(--acc)}
  .aud ul{list-style:none;padding:0}
  .aud li{font:13.5px var(--mono);color:#c9d0dc;padding:6px 0;border-bottom:1px dashed #1c2029}
  .aud li:last-child{border:0}
  .aud li span{color:var(--dim);font-family:inherit;font-size:12.5px}

  .flow{display:flex;flex-wrap:wrap;gap:0;margin-top:36px;font:13px var(--mono)}
  .flow span{display:flex;align-items:center;gap:8px;color:#c9d0dc}
  .flow i{color:var(--dim);font-style:normal;padding:0 10px}
  .flow b{color:var(--acc);font-weight:500}

  footer{padding:48px 0 60px;border-top:1px solid var(--line);color:var(--dim);font-size:13.5px}
  footer .wrap{display:flex;flex-wrap:wrap;gap:18px;align-items:center}
  footer a{color:var(--dim)}
  footer .r{margin-left:auto}
</style>
</head>
<body>

