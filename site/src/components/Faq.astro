---
// FAQ — zero-JS-native accordion (<details>), styled to the flight-recorder system.
import { ui } from "../i18n.js";
const { lang = "en" } = Astro.props;
const f = ui(lang).faq;
const items = f.items;
---
<div class="faq">
  {items.map(([q, a], i) => (
    <details class="rv" data-d={i * 40}>
      <summary>{q}<span class="pl"></span></summary>
      <div class="fa"><p set:html={a} /></div>
    </details>
  ))}
  <p class="fcontact rv" data-d={items.length * 40} set:html={f.contact} />
</div>
<style>
  .faq{margin-top:38px;display:flex;flex-direction:column;gap:10px}
  details{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);transition:border-color .2s,box-shadow .2s}
  details:hover{border-color:var(--line2)}
  details[open]{border-color:#ecd0d0;box-shadow:0 10px 28px #17181c0a}
  summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:16px 20px;font-size:14.5px;font-weight:600;letter-spacing:-.01em;user-select:none}
  summary::-webkit-details-marker{display:none}
  .pl{position:relative;flex:0 0 auto;width:22px;height:22px;border-radius:50%;border:1px solid var(--line2);transition:transform .25s,background .2s,border-color .2s}
  .pl::before,.pl::after{content:"";position:absolute;top:50%;left:50%;background:var(--dim);transition:background .2s}
  .pl::before{width:9px;height:1.6px;transform:translate(-50%,-50%)}
  .pl::after{width:1.6px;height:9px;transform:translate(-50%,-50%)}
  details[open] .pl{transform:rotate(45deg);background:var(--rec-soft);border-color:#f0cdcd}
  details[open] .pl::before,details[open] .pl::after{background:var(--rec)}
  .fa{padding:0 20px 18px}
  .fa p{font-size:13.5px;color:var(--dim);line-height:1.7;max-width:820px}
  .fa code{background:var(--warm);border:1px solid var(--line);border-radius:5px;padding:1px 6px;font-size:12px;color:var(--rec-ink)}
  .fcontact{margin:18px 4px 0;font-size:13px;color:var(--dim)}
  .fcontact a{color:var(--rec-ink);text-decoration:none;border-bottom:1px solid #ecd0d0}
  .fcontact a:hover{border-bottom-color:var(--rec-ink)}
</style>
