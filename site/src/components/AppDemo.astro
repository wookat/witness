---
// Live product demo — fake managed browser auto-playing one SAY → causal burst.
// The product under test is drawn as a real UI (real copy, real layout), not skeleton bars.
---
<div class="stage rv" data-d="120">
  <div class="win">
    <div class="chrome">
      <i class="r"></i><i class="y"></i><i class="g"></i>
      <div class="url"><svg width="10" height="10" viewBox="0 0 12 12"><rect x="2" y="5" width="8" height="6" rx="1.5" fill="none" stroke="currentColor"/><path d="M4 5V3.5a2 2 0 0 1 4 0V5" fill="none" stroke="currentColor"/></svg> localhost:5173/checkout</div>
      <span class="rec"><b></b>00:07</span>
    </div>
    <div class="body">
      <!-- left: the product under test — a ticketing checkout -->
      <div class="app">
        <div class="a-nav"><b>SeatMark</b><span>Events</span><span>Venues</span><span class="cart">Cart · 2</span></div>
        <div class="a-order">
          <div class="a-ev"><div class="thumb"></div><div><b>Coldplay · Music of the Spheres</b><p>Sat 19:30 · National Stadium · Section B2 Row 14</p></div><em>¥1,280</em></div>
          <div class="a-fee"><span>Service fee</span><span>¥60</span></div>
          <div class="a-fee tot"><span>Total</span><span>¥1,340</span></div>
        </div>
        <button class="a-btn" type="button" tabindex="-1">Pay ¥1,340</button>
        <p class="a-hint">Secured checkout · 10:00 reservation hold</p>
        <div class="tb"><b class="dot"></b><span>wit</span><i class="sep"></i><kbd>M</kbd><kbd>N</kbd><kbd>P</kbd><i class="sep"></i><span class="sq"></span></div>
        <div class="bubble"><span class="mic">●</span>“点这个支付按钮完全没反应”</div>
        <svg class="cur" viewBox="0 0 24 24"><path d="M5 3l14 8-6.5 1.5L9 19z" fill="#17181c" stroke="#fff" stroke-width="1.4"/></svg>
        <div class="rip"></div>
      </div>
      <!-- right: live evidence panel -->
      <div class="panel">
        <div class="p-head"><b></b>session.md <em>live</em></div>
        <div class="p-say"><span class="p-ts">00:06</span><span class="p-tag">SAY</span><p>“点这个支付按钮完全没反应”</p></div>
        <div class="p-ev e1"><span class="k ok">CLICK</span><span class="v">button.pay · @318,412</span></div>
        <div class="p-ev e2"><span class="k dim">NET</span><span class="v">— no requests fired</span></div>
        <div class="p-ev e3"><span class="k dim">CONSOLE</span><span class="v">— clean</span></div>
        <div class="p-ev e4"><span class="k dim">MUT</span><span class="v">— no DOM change</span></div>
        <div class="p-note">└─ no reaction for 1.8s —<br>&nbsp;&nbsp;&nbsp;that itself is evidence</div>
      </div>
    </div>
  </div>
</div>

<style>
  .stage{position:relative;max-width:940px;margin:0 auto}
  .win{background:var(--panel);border:1px solid var(--line);border-radius:14px;overflow:hidden;box-shadow:0 30px 70px #17181c17,0 2px 6px #17181c0a}

  .chrome{display:flex;align-items:center;gap:7px;padding:10px 13px;border-bottom:1px solid var(--line);background:#fbfaf7}
  .chrome i{width:10px;height:10px;border-radius:50%}
  .chrome .r{background:#e5484d}.chrome .y{background:#e2a93b}.chrome .g{background:#3d9d63}
  .url{display:flex;align-items:center;gap:6px;margin-left:10px;background:var(--bg);border:1px solid var(--line);border-radius:6px;padding:4px 12px;font:500 11px var(--mono);color:var(--dim)}
  .rec{margin-left:auto;display:flex;align-items:center;gap:6px;font:600 11px var(--mono);color:var(--rec)}
  .rec b{width:7px;height:7px;border-radius:50%;background:var(--rec);animation:blink 1.4s ease-in-out infinite}
  @keyframes blink{50%{opacity:.3}}

  .body{display:grid;grid-template-columns:1.3fr 1fr;min-height:330px}
  @media(max-width:760px){.body{grid-template-columns:1fr}.panel{display:none}}

  /* ---- the product under test: real-looking checkout ---- */
  .app{position:relative;padding:18px 22px;border-right:1px solid var(--line);overflow:hidden;background:#fdfcfa}
  .a-nav{display:flex;align-items:baseline;gap:18px;padding-bottom:16px;border-bottom:1px solid #eeece6}
  .a-nav b{font:800 15px var(--sans);letter-spacing:-.02em}
  .a-nav span{font:500 12px var(--sans);color:var(--dim)}
  .a-nav .cart{margin-left:auto;font:600 11.5px var(--mono);color:var(--ink);background:#efede8;border-radius:6px;padding:3px 9px}
  .a-order{margin:16px 0 14px;border:1px solid #eeece6;border-radius:11px;padding:14px 16px}
  .a-ev{display:flex;align-items:center;gap:12px;padding-bottom:12px;border-bottom:1px dashed #eeece6}
  .a-ev .thumb{width:38px;height:38px;border-radius:8px;background:linear-gradient(135deg,#17181c 20%,#3c4a6b);flex:none;position:relative}
  .a-ev .thumb::after{content:"";position:absolute;inset:12px;border-radius:50%;background:#e5484d;opacity:.85}
  .a-ev b{font:600 12.5px var(--sans)}
  .a-ev p{font:400 11px var(--sans);color:var(--dim);margin-top:2px}
  .a-ev em{margin-left:auto;font:600 13px var(--mono);font-style:normal}
  .a-fee{display:flex;justify-content:space-between;padding-top:10px;font:400 11.5px var(--sans);color:var(--dim)}
  .a-fee.tot{font:700 13px var(--sans);color:var(--ink)}
  .a-fee.tot span:last-child{font-family:var(--mono)}
  .a-btn{width:100%;background:var(--ink);color:#f7f6f3;border:0;border-radius:9px;padding:12px;font:600 13.5px var(--sans);letter-spacing:.01em}
  .a-hint{text-align:center;font:400 10.5px var(--mono);color:var(--faint);margin-top:10px}

  .tb{position:absolute;top:12px;right:14px;display:flex;align-items:center;gap:7px;background:#17181c;border-radius:8px;padding:5px 10px;box-shadow:0 6px 18px #17181c30}
  .tb .dot{width:7px;height:7px;border-radius:50%;background:var(--rec);animation:blink 1.4s ease-in-out infinite}
  .tb span{color:#f7f6f3;font:700 10.5px var(--mono)}
  .tb kbd{color:#8f8ba8;font:600 9px var(--mono);background:#26262e;border-radius:3px;padding:1px 5px}
  .tb .sep{width:1px;height:11px;background:#383845}
  .tb .sq{width:7px;height:7px;border-radius:1.5px;background:#f7f6f3}

  .bubble{position:absolute;left:22px;bottom:16px;display:flex;align-items:center;gap:8px;background:#17181c;color:#f7f6f3;font:500 12px var(--sans);border-radius:11px 11px 11px 3px;padding:9px 14px;box-shadow:0 10px 26px #17181c30;animation:bubble 9s infinite;opacity:0}
  .bubble .mic{color:var(--rec);font-size:9px;animation:blink 1.4s infinite}
  @keyframes bubble{4%{opacity:0;transform:translateY(8px)}9%{opacity:1;transform:none}88%{opacity:1}96%,100%{opacity:0}}

  .cur{position:absolute;width:19px;height:19px;left:70%;top:80%;filter:drop-shadow(0 2px 4px #0003);animation:cur 9s infinite;opacity:0}
  @keyframes cur{
    0%{opacity:0;left:70%;top:80%}
    8%{opacity:1}
    26%,30%{left:47%;top:79%}
    33%{transform:scale(.82)}
    36%{transform:scale(1)}
    78%{opacity:1;left:47%;top:79%}
    88%{opacity:0}
    100%{opacity:0;left:70%;top:80%}
  }
  .rip{position:absolute;left:47%;top:79%;width:26px;height:26px;margin:-13px;border-radius:50%;border:2px solid var(--rec);opacity:0;animation:rip 9s infinite}
  @keyframes rip{31%{opacity:.8;transform:scale(.4)}46%{opacity:0;transform:scale(1.7)}100%{opacity:0}}

  /* ---- evidence panel ---- */
  .panel{background:#fbfaf7;padding:15px 18px;font-family:var(--mono);font-size:12px}
  .p-head{display:flex;align-items:center;gap:7px;color:var(--dim);font-size:10.5px;letter-spacing:.08em;margin-bottom:13px}
  .p-head b{width:7px;height:7px;border-radius:50%;background:var(--rec);animation:blink 1.4s infinite}
  .p-head em{margin-left:auto;font-style:normal;color:var(--faint)}
  .p-say{display:flex;gap:9px;align-items:baseline;background:var(--rec-soft);border:1px solid #f3d8d8;border-radius:9px;padding:9px 12px;animation:pin 9s infinite;opacity:0}
  .p-ts{color:var(--dim);font-size:10.5px;flex:none}
  .p-tag{font-size:9px;font-weight:600;letter-spacing:.1em;color:var(--rec);background:#fff;border-radius:4px;padding:1px 6px;flex:none}
  .p-say p{color:var(--ink);font:500 12px var(--sans)}
  @keyframes pin{10%{opacity:0;transform:translateY(6px)}16%,92%{opacity:1;transform:none}98%,100%{opacity:0}}
  .p-ev{display:flex;gap:9px;padding:5px 0 5px 14px;opacity:0;animation:ev 9s infinite}
  .p-ev .k{width:58px;flex:none;font-size:10px;font-weight:600;padding-top:1px}
  .k.ok{color:var(--ok)}.k.dim{color:var(--faint)}
  .p-ev .v{color:#55534c}
  @keyframes ev{0%,36%{opacity:0;transform:translateX(8px)}42%,92%{opacity:1;transform:none}98%,100%{opacity:0}}
  .e2{animation-name:ev2}.e3{animation-name:ev3}.e4{animation-name:ev4}
  @keyframes ev2{0%,46%{opacity:0;transform:translateX(8px)}52%,92%{opacity:1;transform:none}98%,100%{opacity:0}}
  @keyframes ev3{0%,56%{opacity:0;transform:translateX(8px)}62%,92%{opacity:1;transform:none}98%,100%{opacity:0}}
  @keyframes ev4{0%,66%{opacity:0;transform:translateX(8px)}72%,92%{opacity:1;transform:none}98%,100%{opacity:0}}
  .p-note{margin-top:10px;padding-left:14px;color:var(--rec-ink);font-size:10.5px;line-height:1.6;opacity:0;animation:note 9s infinite}
  @keyframes note{0%,74%{opacity:0;transform:translateY(6px)}82%,92%{opacity:1;transform:none}98%,100%{opacity:0}}
</style>
