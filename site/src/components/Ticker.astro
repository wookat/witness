---
const items = ["voice", "click", "request", "response", "console error", "page error", "mutation", "screenshot", "dom snapshot", "rrweb replay", "network body", "filmstrip", "mark", "region crop", "issue split", "pause"];
const row = [...items, ...items];
---
<div class="ticker" aria-hidden="true">
  <div class="track">
    {row.map(i => <span class="tk"><i></i>{i}</span>)}
  </div>
</div>
<style>
  .ticker{overflow:hidden;border-block:1px solid var(--line);background:var(--panel);padding:13px 0;mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}
  .track{display:flex;gap:34px;width:max-content;animation:slide 36s linear infinite}
  .ticker:hover .track{animation-play-state:paused}
  @keyframes slide{to{transform:translateX(-50%)}}
  .tk{display:flex;align-items:center;gap:10px;font:500 12.5px var(--mono);color:var(--dim);white-space:nowrap}
  .tk i{width:5px;height:5px;border-radius:50%;background:var(--rec);flex:none}
</style>
