---
// Every item opens a real artifact example — fixed CSS list styling & modal click boundaries.
const {
  humans = [],
  agents = [],
  labels = ["For humans", "For AI agents"],
} = Astro.props;
---
<div class="split">
  <div class="card aud rv" data-d="0"><h4>{labels[0]}</h4><ul>
    {humans.map(([f, d, ex]: [string, string, any]) => ex
      ? <li><button class="li" type="button" data-ex={JSON.stringify(ex)}><b>{f}</b><span>{d}</span></button></li>
      : <li class="plain"><b>{f}</b><span>{d}</span></li>)}
  </ul></div>
  <div class="card aud rv" data-d="120"><h4>{labels[1]}</h4><ul>
    {agents.map(([f, d, ex]: [string, string, any]) => ex
      ? <li><button class="li" type="button" data-ex={JSON.stringify(ex)}><b>{f}</b><span>{d}</span></button></li>
      : <li class="plain"><b>{f}</b><span>{d}</span></li>)}
  </ul></div>
</div>

<div class="ax" id="ax" aria-hidden="true">
  <div class="axc" role="dialog" aria-modal="true">
    <div class="axtop">
      <span class="axtitle" id="axtitle"></span>
      <button class="axx" type="button" aria-label="Close">×</button>
    </div>
    <div class="axbody"></div>
    <div class="axcap"></div>
  </div>
</div>

<style>
  .split{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:44px}
  @media(max-width:760px){.split{grid-template-columns:1fr}}
  .aud h4{font:600 12px var(--mono);letter-spacing:.1em;color:var(--acc);margin-bottom:14px;text-transform:uppercase}
  .aud ul{list-style:none;padding:0}
  .aud ul li{border-bottom:1px dashed var(--line)}
  .aud ul li:last-child{border:0}
  .aud ul li.plain,.aud .li{display:flex;justify-content:space-between;align-items:baseline;gap:14px;width:100%;padding:10px 0;text-align:left}
  .li{background:none;border:0;font:inherit;cursor:pointer;border-radius:8px;margin:0 -8px;padding:10px 8px!important;width:calc(100% + 16px)!important;transition:background .15s}
  .li:hover{background:var(--rec-soft)}
  .li b,.aud ul li.plain b{font:600 13px var(--mono);color:var(--ink);white-space:nowrap}
  .li b::after{content:"↗";margin-left:7px;color:var(--rec);font-size:11px}
  .li span,.aud ul li.plain span{color:var(--dim);font-size:12.5px;text-align:right}

  .ax{position:fixed;inset:0;z-index:90;background:#17181cd9;display:none;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(5px)}
  .ax.on{display:flex}
  .axc{position:relative;max-width:min(920px,94vw);max-height:88vh;width:100%;display:flex;flex-direction:column;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px 16px;box-shadow:0 30px 90px #0006;overflow:hidden}
  .axtop{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-bottom:10px;border-bottom:1px solid var(--line);margin-bottom:12px}
  .axtitle{font:700 12.5px var(--mono);color:var(--ink)}
  .axbody{overflow:auto;max-height:66vh}
  .axbody img{display:block;width:100%;height:auto;max-height:64vh;object-fit:contain;border-radius:8px;border:1px solid var(--line);background:#101014}
  .axbody pre{font:12.5px/1.7 var(--mono);background:var(--term);color:var(--term-text);border-radius:10px;padding:16px 18px;white-space:pre-wrap;word-break:break-word;margin:0}
  .axcap{font:500 12px var(--mono);color:var(--dim);margin-top:10px;padding-top:8px;border-top:1px dashed var(--line)}
  .axx{background:var(--warm);border:1px solid var(--line);border-radius:8px;width:28px;height:28px;font-size:18px;line-height:1;color:var(--dim);cursor:pointer;display:inline-flex;align-items:center;justify-content:center}
  .axx:hover{color:var(--ink);border-color:var(--line2)}
</style>

<script>
  const ax = document.getElementById("ax");
  const body = ax?.querySelector(".axbody");
  const cap = ax?.querySelector(".axcap");
  const title = document.getElementById("axtitle");
  document.querySelectorAll<HTMLButtonElement>(".li[data-ex]").forEach(b => b.addEventListener("click", () => {
    const ex = JSON.parse(b.dataset.ex || "{}");
    if (title) title.textContent = b.querySelector("b")?.textContent || "Artifact";
    if (body) {
      body.innerHTML = "";
      if (ex.img) {
        const im = document.createElement("img");
        im.src = ex.img; im.alt = ex.cap || "Artifact preview";
        body.appendChild(im);
      }
      if (ex.pre) {
        const pre = document.createElement("pre");
        if (ex.img) pre.style.marginTop = "12px";
        pre.textContent = ex.pre;
        body.appendChild(pre);
      }
    }
    if (cap) cap.textContent = ex.cap || "";
    ax?.classList.add("on");
    ax?.setAttribute("aria-hidden", "false");
  }));
  const close = () => { ax?.classList.remove("on"); ax?.setAttribute("aria-hidden", "true"); };
  // Click outside modal card (.axc) closes — clicking caption/body/header inside .axc does NOT close
  ax?.addEventListener("click", e => { if (!(e.target as HTMLElement).closest(".axc")) close(); });
  ax?.querySelector(".axx")?.addEventListener("click", close);
  addEventListener("keydown", e => { if (e.key === "Escape") close(); });
</script>
