---
// Every item opens an artifact example — the output isn't a promise, it's clickable.
// Content comes from the locale dict (src/i18n/*): lists, captions, samples.
const {
  humans = [],
  agents = [],
  labels = ["For humans", "For AI agents"],
} = Astro.props;
---
<div class="split">
  <div class="card aud rv" data-d="0"><h4>{labels[0]}</h4><ul>
    {humans.map(([f, d, ex]) => ex
      ? <li><button class="li" data-ex={JSON.stringify(ex)}><b>{f}</b><span>{d}</span></button></li>
      : <li><b>{f}</b><span>{d}</span></li>)}
  </ul></div>
  <div class="card aud rv" data-d="120"><h4>{labels[1]}</h4><ul>
    {agents.map(([f, d, ex]) => ex
      ? <li><button class="li" data-ex={JSON.stringify(ex)}><b>{f}</b><span>{d}</span></button></li>
      : <li><b>{f}</b><span>{d}</span></li>)}
  </ul></div>
</div>
<div class="ax" id="ax" aria-hidden="true"><div class="axc">
  <button class="axx" aria-label="close">×</button>
  <div class="axbody"></div>
  <div class="axcap"></div>
</div></div>
<style>
  .split{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:44px}
  @media(max-width:760px){.split{grid-template-columns:1fr}}
  .aud h4{font:600 12px var(--mono);letter-spacing:.1em;color:var(--acc);margin-bottom:14px;text-transform:uppercase}
  .aud ul{list-style:none;padding:0}
  .aud li{border-bottom:1px dashed var(--line)}
  .aud li:last-child{border:0}
  .aud>li,.aud .li{display:flex;justify-content:space-between;align-items:baseline;gap:14px;width:100%;padding:10px 0;text-align:left}
  .aud>li{padding:10px 0}
  .li{background:none;border:0;font:inherit;cursor:pointer;border-radius:8px;margin:0 -8px;padding:10px 8px!important;transition:background .15s}
  .li:hover{background:var(--rec-soft)}
  .li b{font:600 13px var(--mono);color:var(--ink);white-space:nowrap}
  .li b::after{content:"↗";margin-left:7px;color:var(--rec);font-size:11px}
  .li span{color:var(--dim);font-size:12.5px;text-align:right}
  .aud>li>b{font:600 13px var(--mono);color:var(--ink);white-space:nowrap}
  .aud>li>span{color:var(--dim);font-size:12.5px;text-align:right}
  .ax{position:fixed;inset:0;z-index:90;background:#17181cd9;display:none;align-items:center;justify-content:center;padding:30px;backdrop-filter:blur(4px)}
  .ax.on{display:flex}
  .axc{position:relative;max-width:min(960px,94vw);max-height:88vh;overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:18px;box-shadow:0 30px 90px #0005}
  .axbody img{display:block;max-width:100%;border-radius:8px;border:1px solid var(--line)}
  .axbody pre{font:12.5px/1.7 var(--mono);background:var(--term);color:var(--term-text);border-radius:10px;padding:16px 18px;white-space:pre-wrap;margin:0}
  .axcap{font:500 12px var(--mono);color:var(--faint);margin-top:12px}
  .axx{position:absolute;top:10px;right:12px;background:none;border:0;font-size:20px;color:var(--faint);cursor:pointer;z-index:1}
  .axx:hover{color:var(--ink)}
</style>
<script>
  const ax = document.getElementById("ax");
  const body = ax?.querySelector(".axbody"), cap = ax?.querySelector(".axcap");
  document.querySelectorAll(".li[data-ex]").forEach(b => b.addEventListener("click", () => {
    const ex = JSON.parse(b.dataset.ex);
    body.innerHTML = ex.img ? `<img src="${ex.img}" alt="example">` : `<pre></pre>`;
    if (ex.pre) body.querySelector("pre").textContent = ex.pre;
    cap.textContent = ex.cap || "";
    ax.classList.add("on"); ax.setAttribute("aria-hidden", "false");
  }));
  const close = () => { ax?.classList.remove("on"); ax?.setAttribute("aria-hidden", "true"); };
  ax?.addEventListener("click", e => { if (!(e.target as HTMLElement).closest(".axbody")) close(); });
  ax?.querySelector(".axx")?.addEventListener("click", close);
  addEventListener("keydown", e => { if (e.key === "Escape") close(); });
</script>
