---
// The brand motif: a three-lane "session tape" — voice / operations / shots —
// with a red playhead sweeping left to right, like a recorder running.
const wave = Array.from({length: 96}, (_, i) => Math.round(18 + Math.abs(Math.sin(i * .7) * 30 + Math.sin(i * 2.3) * 14)));
const ops = [[8,"click"],[14,"key"],[23,"click"],[31,"nav"],[37,"click"],[44,"input"],[52,"click"],[58,"scroll"],[66,"click"],[74,"key"],[82,"click"],[90,"nav"]];
const shots = [10,26,38,55,69,84];
const ticks = [0,25,50,75,100];
// a hot segment of denser speech — bars inside the range get the rec accent
const hot = [26, 61];
---
<div class="tape rv" data-d="380" aria-hidden="true">
  <div class="thd"><span class="rec"><i></i>REC</span><span class="tm">00:02:47</span><span class="src">doubao-web · 16kHz PCM</span></div>
  <div class="rul">{ticks.map(x => <b style={`left:${x}%`}>{x === 0 ? "0:00" : x === 100 ? "2:47" : `0:${Math.round(x * 1.67)}`}</b>)}</div>
  <div class="lane"><span class="lb voice"><i></i>voice</span><div class="tr">
    {wave.map((h, i) => <i class={"w" + (i >= hot[0] && i <= hot[1] ? " hot" : "")} style={`height:${h}%`}></i>)}
  </div></div>
  <div class="lane"><span class="lb ops"><i></i>ops</span><div class="tr">
    {ops.map(([x,k]) => <i class={"t " + k} style={`left:${x}%`} title={k}></i>)}
  </div></div>
  <div class="lane"><span class="lb shots"><i></i>shots</span><div class="tr">
    {shots.map(x => <i class="s" style={`left:${x}%`}></i>)}
  </div></div>
  <div class="ph"></div>
</div>
<style>
  .tape{position:relative;max-width:820px;margin:56px auto 0;border:1px solid var(--line);border-radius:14px;background:var(--panel);padding:14px 20px 16px;box-shadow:0 14px 40px #17181c0d}
  .thd{display:flex;align-items:center;gap:14px;padding-bottom:10px;border-bottom:1px solid var(--line);font:600 10.5px var(--mono);letter-spacing:.1em}
  .rec{display:flex;align-items:center;gap:7px;color:var(--rec)}
  .rec i{width:7px;height:7px;border-radius:50%;background:var(--rec);animation:pulse 1.6s ease-in-out infinite}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
  .tm{color:var(--ink)}
  .src{margin-left:auto;color:var(--faint);font-weight:500}
  .rul{position:relative;height:16px;border-bottom:1px solid var(--line);
    background:repeating-linear-gradient(90deg,var(--line2) 0 1px,transparent 1px calc(100%/40))}
  .rul b{position:absolute;top:3px;font:500 9px var(--mono);color:var(--faint);transform:translateX(-50%)}
  .rul b:first-child{transform:none}.rul b:last-child{transform:translateX(-100%)}
  .lane{display:flex;align-items:center;gap:14px;padding:7px 0;border-bottom:1px dashed var(--line)}
  .lane:last-of-type{border-bottom:0}
  .lb{flex:none;width:52px;text-align:right;font:600 9.5px var(--mono);letter-spacing:.12em;color:var(--faint);text-transform:uppercase;display:flex;align-items:center;justify-content:flex-end;gap:6px}
  .lb i{width:6px;height:6px;border-radius:50%}
  .lb.voice i{background:var(--rec)}
  .lb.ops i{background:var(--info)}
  .lb.shots i{background:var(--ok)}
  .tr{position:relative;flex:1;height:34px}
  .w{position:relative;display:inline-block;width:calc(100%/96 - 3px);margin-right:3px;background:#c9c7c0;border-radius:2px;vertical-align:middle;top:50%;transform:translateY(-50%);min-height:2px}
  .w.hot{background:#e5484d66}
  .tr .t{position:absolute;top:50%;transform:translate(-50%,-50%);width:2px;height:16px;background:var(--info);border-radius:1px}
  .tr .t.click{height:22px;background:var(--rec)}
  .tr .t.nav{height:22px;background:var(--amber)}
  .tr .s{position:absolute;top:50%;transform:translate(-50%,-50%);width:12px;height:16px;border:1.5px solid var(--ok);border-radius:3px;background:#3d9d6318}
  .ph{position:absolute;top:52px;bottom:14px;left:20%;width:2px;background:var(--rec);box-shadow:0 0 12px #e5484d88;animation:sweep 12s linear infinite}
  .ph::before{content:"";position:absolute;top:-5px;left:50%;transform:translateX(-50%);width:10px;height:10px;border-radius:50%;background:var(--rec);border:2px solid var(--panel)}
  @keyframes sweep{from{left:9%}to{left:97%}}
</style>
