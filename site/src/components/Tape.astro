---
// The brand motif: a three-lane "session tape" — voice / operations / shots —
// with a red playhead sweeping left to right, like a recorder running.
const wave = Array.from({length: 96}, (_, i) => Math.round(18 + Math.abs(Math.sin(i * .7) * 30 + Math.sin(i * 2.3) * 14)));
const ops = [[8,"click"],[14,"key"],[23,"click"],[31,"nav"],[37,"click"],[44,"input"],[52,"click"],[58,"scroll"],[66,"click"],[74,"key"],[82,"click"],[90,"nav"]];
const shots = [10,26,38,55,69,84];
---
<div class="tape rv" data-d="380" aria-hidden="true">
  <div class="lane"><span class="lb">voice</span><div class="tr">
    {wave.map(h => <i class="w" style={`height:${h}%`}></i>)}
  </div></div>
  <div class="lane"><span class="lb">ops</span><div class="tr">
    {ops.map(([x,k]) => <i class={"t " + k} style={`left:${x}%`} title={k}></i>)}
  </div></div>
  <div class="lane"><span class="lb">shots</span><div class="tr">
    {shots.map(x => <i class="s" style={`left:${x}%`}></i>)}
  </div></div>
  <div class="ph"></div>
  <div class="tc"><b>00:00</b><b>SESSION TAPE · 3 TRACKS</b><b>02:47</b></div>
</div>
<style>
  .tape{position:relative;max-width:820px;margin:56px auto 0;border:1px solid var(--line);border-radius:14px;background:var(--panel);padding:18px 20px 12px;box-shadow:0 14px 40px #17181c0d}
  .lane{display:flex;align-items:center;gap:14px;padding:7px 0;border-bottom:1px dashed var(--line)}
  .lane:last-of-type{border-bottom:0}
  .lb{flex:none;width:44px;text-align:right;font:600 9.5px var(--mono);letter-spacing:.12em;color:var(--faint);text-transform:uppercase}
  .tr{position:relative;flex:1;height:34px}
  .w{position:relative;display:inline-block;width:calc(100%/96 - 3px);margin-right:3px;background:#c9c7c0;border-radius:2px;vertical-align:middle;top:50%;transform:translateY(-50%);min-height:2px}
  .tr .t{position:absolute;top:50%;transform:translate(-50%,-50%);width:2px;height:16px;background:var(--info);border-radius:1px}
  .tr .t.click{height:22px;background:var(--rec)}
  .tr .t.nav{height:22px;background:var(--amber)}
  .tr .s{position:absolute;top:50%;transform:translate(-50%,-50%);width:12px;height:16px;border:1.5px solid var(--ok);border-radius:3px;background:#3d9d6318}
  .ph{position:absolute;top:10px;bottom:26px;left:20%;width:2px;background:var(--rec);box-shadow:0 0 12px #e5484d88;animation:sweep 12s linear infinite}
  .ph::before{content:"";position:absolute;top:-5px;left:-5px;width:10px;height:10px;border-radius:50%;background:var(--rec);border:2px solid var(--panel)}
  @keyframes sweep{from{left:8%}to{left:98%}}
  .tc{display:flex;justify-content:space-between;padding-top:8px;font:500 10px var(--mono);color:var(--faint);letter-spacing:.08em}
  .tc b:nth-child(2){letter-spacing:.2em}
</style>
