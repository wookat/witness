---
// The recording remote — every control there is, as keycaps.
import { ui } from "../i18n.js";
const { lang = "en", d = "0" } = Astro.props;
const t = ui(lang).keys;
const items = t.items, cap = t.cap;
---
<div class="keys rv" data-d={d}>
  <div class="kcap">{cap}</div>
  <div class="krow">
    {items.map(([ks, txt]) => (
      <div class="ki">
        <span class="kb">{ks.map(k => k === "+" || k === "/" ? <i class="op">{k}</i> : <kbd>{k}</kbd>)}</span>
        <span class="kt">{txt}</span>
      </div>
    ))}
  </div>
</div>
<style>
  .keys{margin-top:34px;background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:18px 22px}
  .kcap{font:600 10.5px var(--mono);letter-spacing:.14em;color:var(--faint);text-transform:uppercase;margin-bottom:14px}
  .krow{display:flex;flex-wrap:wrap;gap:10px 26px}
  .ki{display:flex;align-items:center;gap:10px}
  .kb{display:inline-flex;align-items:center;gap:4px;white-space:nowrap}
  kbd{font:600 11px var(--mono);color:var(--ink);background:#fff;border:1px solid var(--line2);border-bottom-width:2.5px;border-radius:6px;padding:3px 8px;box-shadow:0 1px 0 #17181c08}
  .op{color:var(--faint);font-style:normal;font-size:11px}
  .kt{font-size:12.5px;color:var(--dim)}
</style>
