---
// The conversation script rendered as a real chat UI — agent bubbles left,
// user bubbles right. Not a terminal: this is what talking to your agent looks like.
import { ui } from "../i18n.js";
const { lang = "en", d = "0" } = Astro.props;
const t = ui(lang).convo;
---
<div class="convo rv" data-d={d}>
  <div class="chd"><span class="cw y">{t.you}</span><span class="cd">×</span><span class="cw a">agent</span></div>
  {t.msgs.map(([w, txt, k]) => w === "n"
    ? <div class="act">{txt}</div>
    : <div class={"m " + w}><div class={"b" + (k === "ok" ? " k" : "")}>{txt}</div></div>)}
</div>
<style>
  .convo{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:22px 22px 14px;box-shadow:0 16px 44px #17181c0e}
  .chd{display:flex;align-items:center;gap:8px;margin-bottom:18px;font:600 11px var(--mono);letter-spacing:.1em}
  .chd .y{color:var(--rec)}
  .chd .a{color:var(--ok)}
  .chd .cd{color:var(--faint)}
  .m{display:flex;margin-bottom:12px}
  .m.y{justify-content:flex-end}
  .b{max-width:78%;border-radius:14px;padding:10px 15px;font-size:14px;line-height:1.55;box-shadow:0 3px 12px #17181c0a}
  .m.y .b{background:var(--ink);color:#f7f6f3;border-bottom-right-radius:4px}
  .m.a .b{background:#fff;border:1px solid var(--line);color:var(--ink);border-bottom-left-radius:4px;font-family:var(--mono);font-size:12.5px}
  .b.k{border-left:3px solid var(--ok)}
  .act{text-align:center;font:500 12px var(--mono);color:var(--faint);margin:6px 0 12px}
  .act::before,.act::after{content:"———";color:var(--line);letter-spacing:2px;margin:0 10px}
</style>
