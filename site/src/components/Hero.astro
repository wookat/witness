---
import Tape from "./Tape.astro";
const GH = "https://github.com/wookat/witness";
const { lang = "en" } = Astro.props;
const t = lang === "zh" ? {
  pill: "开源 · MIT · 本地优先",
  h1a: "你开口，", h1b: "Witness 补全", rot: ["证据。", "那个 bug。", "那次卡顿。", "那个 500。", "前因后果。"],
  sub: "像平时一样体验产品、用嘴说出哪里不对——“这个按钮点了没反应”。Witness 把你说的每句话焊死在那一秒的因果证据上，然后把证据包交给你的 AI 编码 agent。",
  cta1: "查看 GitHub", cta2: "工作原理 ↓",
} : {
  pill: "OPEN SOURCE · MIT · LOCAL-FIRST",
  h1a: "You say it.", h1b: "Witness proves", rot: ["it.", "the bug.", "the jank.", "the 500.", "the why."],
  sub: "Experience your product and talk naturally — “this button does nothing”. Witness welds every word to the causal evidence of that exact second, then hands the package to your AI coding agent.",
  cta1: "View on GitHub", cta2: "How it works ↓",
};
---
<header class="hero"><div class="wrap">
  <span class="pill rv"><i></i>{t.pill}</span>
  <h1 class="rv" data-d="80">{t.h1a}<br>{t.h1b} <span class="rot" id="rot">{t.rot[0]}</span></h1>
  <p class="sub rv" data-d="160">{t.sub}</p>
  <div class="cta rv" data-d="240">
    <a class="btn pri" href={GH}>{t.cta1}</a>
    <a class="btn" href="#how">{t.cta2}</a>
  </div>
  <div class="install rv" data-d="320"><b>$</b><span id="typed"></span><span class="cur"></span><button title="copy" onclick="navigator.clipboard.writeText('npm i -g github:wookat/witness')">⧉</button></div>
  <Tape />
</div></header>
<style>
  .hero{position:relative;padding:96px 0 88px;text-align:center}
  .pill{display:inline-flex;align-items:center;gap:8px;font:500 11px var(--mono);color:var(--rec);background:var(--rec-soft);border:1px solid #f3d3d3;border-radius:999px;padding:6px 15px;letter-spacing:.09em;margin-bottom:30px}
  .pill i{width:6px;height:6px;border-radius:50%;background:var(--rec);animation:pulse 2.2s ease-in-out infinite}
  @keyframes pulse{0%,100%{opacity:1;box-shadow:0 0 0 0 #e5484d55}50%{opacity:.5;box-shadow:0 0 0 5px #e5484d00}}
  h1{font-size:clamp(42px,7.2vw,76px);line-height:1.05;font-weight:800;letter-spacing:-.035em}
  h1 .rot{display:inline-block;min-width:4.6ch;text-align:left;vertical-align:bottom;color:var(--rec);transition:opacity .22s}
  .sub{max-width:600px;margin:24px auto 0;color:var(--dim);font-size:17.5px}
  .cta{display:flex;gap:12px;justify-content:center;margin-top:34px}
  .install{display:inline-flex;align-items:center;gap:12px;margin-top:28px;background:var(--term);border:1px solid var(--term-line);border-radius:10px;padding:13px 18px;font:500 13.5px var(--mono);color:var(--term-text);box-shadow:0 10px 28px #17181c14}
  .install b{color:var(--rec);font-weight:600}
  .install .cur{width:8px;height:1.1em;background:var(--rec);animation:blink 1s steps(1) infinite}
  @keyframes blink{50%{opacity:0}}
  .install button{background:none;border:0;color:#77767f;cursor:pointer;font:inherit;font-size:15px;padding:0;transition:color .15s}
  .install button:hover{color:var(--term-text)}
</style>
<script define:vars={{ words: t.rot }}>
  const el = document.getElementById("rot");
  let wi = 0;
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (el && !reduced) setInterval(() => {
    wi = (wi + 1) % words.length;
    el.style.opacity = "0";
    setTimeout(() => { el.textContent = words[wi]; el.style.opacity = "1"; }, 220);
  }, 2400);
  const cmd = "npm i -g github:wookat/witness";
  const t = document.getElementById("typed");
  if (t && !reduced) {
    let i = 0;
    const tick = () => { t.textContent = cmd.slice(0, ++i); if (i < cmd.length) setTimeout(tick, 34 + Math.random() * 46); };
    setTimeout(tick, 700);
  } else if (t) t.textContent = cmd;
</script>
