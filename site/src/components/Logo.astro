---
const { size = 22 } = Astro.props;
---
<span class="logo">
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="8" fill="#17181c"/>
    <!-- viewfinder corners -->
    <path d="M9.5 12.5v-2a1.5 1.5 0 0 1 1.5-1.5h2" fill="none" stroke="#8f8b9e" stroke-width="1.5" stroke-linecap="round"/>
    <path d="M19 9h2a1.5 1.5 0 0 1 1.5 1.5v2" fill="none" stroke="#8f8b9e" stroke-width="1.5" stroke-linecap="round"/>
    <path d="M22.5 19.5v2a1.5 1.5 0 0 1-1.5 1.5h-2" fill="none" stroke="#8f8b9e" stroke-width="1.5" stroke-linecap="round"/>
    <path d="M13 23h-2a1.5 1.5 0 0 1-1.5-1.5v-2" fill="none" stroke="#8f8b9e" stroke-width="1.5" stroke-linecap="round"/>
    <!-- almond eye -->
    <path d="M9.8 16C11.8 12.6 14.2 10.9 16 10.9s4.2 1.7 6.2 5.1c-2 3.4-4.4 5.1-6.2 5.1s-4.2-1.7-6.2-5.1Z" fill="none" stroke="#f7f6f3" stroke-width="1.7"/>
    <!-- record pupil with glint -->
    <circle cx="16" cy="16" r="3" fill="#e5484d"/>
    <circle cx="15" cy="15" r="0.9" fill="#fff" opacity=".85"/>
  </svg>
  <span class="wm">w<span class="idot">ı<span class="dot"></span></span>tness</span>
</span>
<style>
  .logo{display:inline-flex;align-items:center;gap:9px}
  .wm{font-weight:800;font-size:16.5px;letter-spacing:-.02em;color:var(--ink)}
  .idot{position:relative}
  .idot .dot{position:absolute;left:50%;top:.02em;transform:translateX(-50%);width:.24em;height:.24em;border-radius:50%;background:var(--rec);animation:pulse 2.2s ease-in-out infinite}
  @keyframes pulse{0%,100%{opacity:1;box-shadow:0 0 0 0 #e5484d66}50%{opacity:.55;box-shadow:0 0 0 4px #e5484d00}}
</style>
