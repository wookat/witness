---
const { size = 24 } = Astro.props;
---
<span class="logo">
  <svg width={size} height={size * 0.7} viewBox="0 0 64 44" aria-hidden="true">
    <path d="M14 14 L21 30 L28 8 L35 30 L42 14" fill="none" stroke="currentColor" stroke-width="4.6" stroke-linecap="round" stroke-linejoin="round"/>
    <circle cx="48.5" cy="22" r="4.8" fill="#ff4f00"/>
  </svg>
  <span class="wm">w<span class="idot">ı<span class="dot"></span></span>tness</span>
</span>
<style>
  .logo{display:inline-flex;align-items:center;gap:9px;color:var(--ink)}
  .wm{font-weight:800;font-size:16.5px;letter-spacing:-.02em;color:var(--ink)}
  .idot{position:relative}
  .idot .dot{position:absolute;left:50%;top:.02em;transform:translateX(-50%);width:.24em;height:.24em;border-radius:50%;background:#ff4f00;animation:pulse 2.2s ease-in-out infinite}
  @keyframes pulse{0%,100%{opacity:1;box-shadow:0 0 0 0 #ff4f0066}50%{opacity:.55;box-shadow:0 0 0 4px #ff4f0000}}
</style>
