---
// Interactive evidence-timeline demo — click a SAY to expand its causal burst.
const defaultSays = [
  {
    t: "00:09",
    quote: "the button fades and shrinks when I scroll",
    ev: [
      ["SCROLL", "y=3936", "dim"],
      ["MUT", "button.feedback · data-collapsed: false → true", "acc2"],
      ["MUT", "button.feedback · data-collapsed: true → false", "acc2"],
    ],
    note: "attribute flapping on the boundary",
    ui: "scroll",
  },
  {
    t: "00:34",
    quote: "the submit button does nothing",
    ev: [["CLICK", "button#submit “Submit” · @482,701", "ok"]],
    note: "page showed no reaction for 1.8s after the click — that itself is evidence",
    ui: "btn",
  },
  {
    t: "01:02",
    quote: "the orders API returns wrong data",
    ev: [
      ["CLICK", "a[href=\"/orders\"] “Orders”", "ok"],
      ["NET →", "GET /api/orders?page=1", "dim"],
      ["NET ←", "200 /api/orders · items: []", "bad"],
    ],
    note: "response body captured → bodies/req_0041.json",
    ui: "api",
  },
];
const { says = defaultSays, hint = "click a quote to expand its evidence" } = Astro.props;
---
<div class="demo rv" data-d="100">
  <div class="bar"><i></i><i></i><i></i><span>session.md — interactive</span><em>{hint}</em></div>
  <div class="tl">
    {says.map((s, i) => (
      <div class={"say" + (i === 0 ? " open" : "")} data-i={i}>
        <button class="head" type="button">
          <span class="ts">{s.t}</span>
          <span class="tag">SAY</span>
          <span class="q">“{s.quote}”</span>
          <svg class="chev" width="12" height="12" viewBox="0 0 12 12"><path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </button>
        <div class="burst"><div class="burst-in">
          <div class="rows">
            {s.ev.map(([k, v, c]) => <div class="row"><span class={"k " + c}>{k}</span><span class="v">{v}</span></div>)}
            <div class="note">└─ {s.note}</div>
          </div>
          <button class={"shot " + s.ui} type="button" title="click to enlarge">
            <div class="vp">
              {s.ui === "btn" && <><div class="ui-bar"></div><div class="ui-btn"></div><div class="ui-line l1"></div><div class="ui-line l2"></div></>}
              {s.ui === "scroll" && <><div class="ui-bar"></div><div class="ui-card"></div><div class="ui-card short"></div><div class="ui-btn small"></div></>}
              {s.ui === "api" && <><div class="ui-bar"></div><div class="ui-row"></div><div class="ui-row"></div><div class="ui-row empty"></div><div class="ui-row empty"></div></>}
            </div>
            <span>shot_{s.t.replace(":","")}.png</span>
          </button>
        </div></div>
      </div>
    ))}
  </div>
</div>
<style>
  .demo{background:var(--term);border:1px solid var(--term-line);border-radius:var(--r);overflow:hidden;margin-top:44px;box-shadow:0 24px 60px #17171c24;font-family:var(--mono)}
  .bar{display:flex;align-items:center;gap:7px;padding:12px 16px;border-bottom:1px solid var(--term-line);color:#8b87a3;font-size:11.5px}
  .bar i{width:10px;height:10px;border-radius:50%}
  .bar i:nth-child(1){background:#ef4444}.bar i:nth-child(2){background:#f4b83f}.bar i:nth-child(3){background:#3fc96a}
  .bar span{margin-left:8px}
  .bar em{margin-left:auto;font-style:normal;color:#5b5871}
  @media(max-width:640px){.bar em{display:none}}

  .tl{padding:8px 0}
  .say{border-left:2px solid transparent}
  .say.open{border-left-color:var(--rec)}
  .head{display:flex;align-items:baseline;gap:12px;width:100%;background:none;border:0;padding:14px 20px;cursor:pointer;text-align:left;font:inherit;color:var(--term-text)}
  .head:hover{background:#ffffff08}
  .ts{color:#6f6b87;font-size:12px;flex:none}
  .tag{font-size:10px;font-weight:600;letter-spacing:.1em;color:var(--rec);background:#e5484d1e;border-radius:4px;padding:2px 7px;flex:none}
  .q{font-size:13.5px;color:#eceaf4}
  .chev{margin-left:auto;flex:none;color:#6f6b87;transition:transform .25s}
  .say.open .chev{transform:rotate(180deg)}

  .burst{display:grid;grid-template-rows:0fr;transition:grid-template-rows .3s cubic-bezier(.2,.6,.2,1)}
  .say.open .burst{grid-template-rows:1fr}
  .burst-in{overflow:hidden;opacity:0;transition:opacity .22s .05s}
  .say.open .burst-in{opacity:1}
  .burst-in{display:flex;gap:18px;padding:2px 20px 18px 84px}
  @media(max-width:640px){.burst-in{flex-direction:column;padding-left:20px}}
  .rows{flex:1;min-width:0}
  .row{display:flex;gap:10px;padding:4px 0;font-size:12.5px}
  .k{flex:none;width:56px;font-weight:600;font-size:11px;padding-top:2px}
  .k.ok{color:#6fce97}.k.bad{color:#f28b86}.k.dim{color:#6a6a75}.k.acc2{color:#e8c476}
  .v{color:#b8b4d6;word-break:break-all}
  .note{padding:6px 0 0 66px;font-size:12px;color:#6f6b87;font-style:italic}
  @media(max-width:640px){.note{padding-left:0}}

  .shot{flex:none;width:170px;background:none;border:0;padding:0;font:inherit;text-align:center;cursor:zoom-in}
  .shot .vp{height:104px;border-radius:10px;background:linear-gradient(160deg,#1d1c24,#141319);border:1px solid #302e3d;position:relative;overflow:hidden;transition:border-color .2s,transform .2s}
  .shot:hover .vp{border-color:#565270;transform:scale(1.03)}
  .shot span{display:block;margin-top:7px;font-size:10.5px;color:#5b5871;text-align:center}
  .ui-bar{position:absolute;top:9px;left:10px;right:10px;height:6px;border-radius:3px;background:#3d3956}
  .ui-btn{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);width:74px;height:20px;border-radius:10px;background:linear-gradient(135deg,#2a2b31,#17181c)}
  .ui-btn.small{width:46px;height:13px;bottom:auto;top:70px}
  .ui-line{position:absolute;left:22px;right:22px;height:5px;border-radius:3px;background:#34314c}
  .ui-line.l1{top:34px}.ui-line.l2{top:47px;right:50px}
  .ui-card{position:absolute;top:26px;left:10px;right:10px;height:34px;border-radius:7px;background:#2b2840}
  .ui-card.short{top:66px;right:60px;height:26px}
  .ui-row{position:absolute;left:10px;right:10px;height:14px;border-radius:4px;background:#2e2b44}
  .ui-row:nth-of-type(2){top:26px}.ui-row:nth-of-type(3){top:46px}.ui-row:nth-of-type(4){top:66px}.ui-row:nth-of-type(5){top:86px}
  .ui-row.empty{background:transparent;border:1px dashed #413e52}

  /* lightbox */
  .lb{position:fixed;inset:0;z-index:80;background:#0d0d12cf;backdrop-filter:blur(8px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;opacity:0;pointer-events:none;transition:opacity .22s}
  .lb.on{opacity:1;pointer-events:auto}
  .lb .stage{width:170px;height:104px;transform:scale(2.6) translateY(-4px);transform-origin:center}
  .lb .vp{width:170px;height:104px;border-radius:10px;background:linear-gradient(160deg,#1d1c24,#141319);border:1px solid #3a3747;position:relative;overflow:hidden}
  .lb .cap{font:500 12px var(--mono);color:#9d99b8;margin-top:96px}
  .lb .hint{position:absolute;bottom:26px;font:500 10.5px var(--mono);color:#5b5871;letter-spacing:.1em}
</style>
<div class="lb" id="wit-lb" aria-hidden="true"><div class="stage"><div class="vp" id="wit-lb-vp"></div></div><span class="cap" id="wit-lb-cap"></span><span class="hint">ESC / CLICK TO CLOSE</span></div>
<script>
  document.querySelectorAll(".demo .head").forEach(h => h.addEventListener("click", () => {
    const s = h.parentElement;
    const was = s.classList.contains("open");
    s.parentElement.querySelectorAll(".say").forEach(x => x.classList.remove("open"));
    if (!was) s.classList.add("open");
  }));
  const lb = document.getElementById("wit-lb"), lbvp = document.getElementById("wit-lb-vp"), lbcap = document.getElementById("wit-lb-cap");
  const closeLb = () => lb.classList.remove("on");
  document.querySelectorAll(".demo .shot").forEach(sh => sh.addEventListener("click", e => {
    e.stopPropagation();
    lbvp.innerHTML = sh.querySelector(".vp").innerHTML;
    lbcap.textContent = sh.querySelector("span").textContent + " · " + sh.closest(".say").querySelector(".ts").textContent;
    lb.classList.add("on");
  }));
  lb.addEventListener("click", closeLb);
  addEventListener("keydown", e => { if (e.key === "Escape") closeLb(); });
</script>
