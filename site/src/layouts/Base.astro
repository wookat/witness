---
import Logo from "../components/Logo.astro";
import { ui, LANGS } from "../i18n.js";
const { lang = "en", title, desc } = Astro.props;
const GH = "https://github.com/wookat/witness";
const t = ui(lang);
const cur = LANGS.find(l => l.code === lang) ?? LANGS[0];
const pageTitle = title ?? t.meta.title;
const pageDesc = desc ?? t.meta.desc;
const home = cur.path === "/" ? "" : cur.path.slice(0, -1);   // "" or "/zh" or "/zh-hant" or "/ja"
const nav = [["#how",t.nav.how],["#evidence",t.nav.evidence],["#mcp",t.nav.mcp],["#install",t.nav.install],["#faq",t.nav.faq]]
  .map(([a, l]) => [(home || "/") + a, l]);
nav.push([t.docsPath, t.nav.docs]);
const f = t.footer;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const isHome = Astro.url.pathname === cur.path;
const OG_LOCALE = { en: "en_US", zh: "zh_CN", "zh-hant": "zh_TW", ja: "ja_JP" };
const strip = (s: string) => s.replace(/<[^>]+>/g, "").replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&amp;/g, "&").replace(/\s+/g, " ").trim();
const ldApp = {
  "@context": "https://schema.org", "@type": "SoftwareApplication",
  name: "Witness", alternateName: "witness-recorder",
  applicationCategory: "DeveloperApplication", operatingSystem: "Windows, macOS, Linux",
  softwareVersion: "0.3.0", license: "https://opensource.org/licenses/MIT",
  description: "Voice-anchored evidence recorder for AI coding agents. Records speech, clicks, requests, console errors and DOM state into a local causal evidence bundle that agents can fix from.",
  url: "https://witness.zalize.com", codeRepository: GH,
  downloadUrl: "https://github.com/wookat/witness",
  author: { "@type": "Person", name: "zalize", url: "https://github.com/wookat" },
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  keywords: "MCP server, AI agent tools, bug reporting, session replay, voice recording, developer tools, CLI",
};
const ldFaq = isHome && {
  "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: t.faq.items.map(([q, a]: [string, string]) => ({
    "@type": "Question", name: strip(q),
    acceptedAnswer: { "@type": "Answer", text: strip(a) },
  })),
};
const fcols = [
  [f.cols[0], [[home+"#how",f.product.how],[home+"#evidence",f.product.evidence],[home+"#mcp",f.product.mcp],[home+"#faq",f.product.faq],[home+"#install",f.product.install]]],
  [f.cols[1], [[t.docsPath,f.docs.usage],[GH,f.docs.readme],[GH+"/blob/main/VISION.md",f.docs.vision],[GH+"/releases",f.docs.releases]]],
  [f.cols[2], [[GH,f.community.github],[GH+"/issues",f.community.issues],["mailto:wookat@qq.com",f.community.contact],[GH+"/blob/main/LICENSE",f.community.license],[GH+"/stargazers",f.community.stars]]],
];
---
<!doctype html>
<html lang={cur.htmlLang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{pageTitle}</title>
<meta name="description" content={pageDesc}>
{LANGS.map(l => <link rel="alternate" hreflang={l.htmlLang} href={new URL(l.path, Astro.site).href} />)}
<link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site).href} />
<link rel="canonical" href={canonical}>
<meta property="og:title" content="Witness — your voice, welded to the evidence">
<meta property="og:description" content="Say what's wrong, point at it, keep going. One recording → a causal evidence package your AI coding agent can fix from.">
<meta property="og:image" content="https://witness.zalize.com/og.png">
<meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
<meta property="og:site_name" content="Witness">
<meta property="og:locale" content={OG_LOCALE[cur.code]}>
{LANGS.filter(l => l.code !== cur.code).map(l => <meta property="og:locale:alternate" content={OG_LOCALE[l.code]} />)}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Witness — your voice, welded to the evidence">
<meta name="twitter:description" content="One recording → a causal evidence package your AI coding agent can fix from. Open source, MIT, local-first.">
<meta name="twitter:image" content="https://witness.zalize.com/og.png">
<script type="application/ld+json" set:html={JSON.stringify(ldApp)} />
{ldFaq && <script type="application/ld+json" set:html={JSON.stringify(ldFaq)} />}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%2317181c'/><g transform='translate(-0.35 1.5)'><path d='M7 12 L10.5 20 L14 9 L17.5 20 L21 12' fill='none' stroke='%23f7f6f3' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'/><circle cx='24.5' cy='14.5' r='2.3' fill='%23ff4f00'/></g></svg>">
<style is:global>
  :root{
    /* flight-recorder design tokens */
    --bg:#f7f6f3; --panel:#ffffff; --warm:#efede8; --line:#e3e1da; --line2:#d4d2ca;
    --ink:#17181c; --dim:#67676d; --faint:#9c9ca2;
    --rec:#e5484d; --rec-ink:#c13a3f; --rec-soft:#fceeee;
    --amber:#e2a93b; --ok:#3d9d63; --info:#5b7fb8;
    --term:#101014; --term-line:#26262e; --term-text:#d6d4cc;
    --mono:"Geist Mono",ui-monospace,"SF Mono","Cascadia Code",Consolas,monospace;
    --sans:"Inter",-apple-system,"Segoe UI","Helvetica Neue",sans-serif;
    --r:12px;
    --acc:var(--rec); --acc2:var(--amber); --acc-soft:var(--rec-soft); --acc-ink:var(--rec-ink);
  }
  *{box-sizing:border-box;margin:0}
  html{scroll-behavior:smooth;scrollbar-width:thin;scrollbar-color:#c6c4bc transparent}
  ::-webkit-scrollbar{width:10px;height:10px}
  ::-webkit-scrollbar-track{background:transparent}
  ::-webkit-scrollbar-thumb{background:#c6c4bc;border:3px solid var(--bg);border-radius:8px}
  ::-webkit-scrollbar-thumb:hover{background:#a5a39b}
  ::-webkit-scrollbar-corner{background:transparent}
  body{background:var(--bg);color:var(--ink);font:16px/1.65 var(--sans);-webkit-font-smoothing:antialiased;overflow-x:hidden}
  .wrap{max-width:1080px;margin:0 auto;padding:0 24px}
  a{color:inherit}
  code,pre{font-family:var(--mono)}
  ::selection{background:#e5484d2e}

  /* ---------- scroll reveal ---------- */
  .rv{opacity:0;transform:translateY(18px);transition:opacity .65s cubic-bezier(.2,.6,.2,1),transform .65s cubic-bezier(.2,.6,.2,1)}
  .rv.on{opacity:1;transform:none}
  @media(prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none} *{animation:none!important;transition:none!important}}

  /* ---------- floating pill nav ---------- */
  nav{position:fixed;top:14px;left:0;right:0;z-index:50;pointer-events:none}
  nav .wrap{pointer-events:auto;display:flex;align-items:center;gap:24px;height:54px;max-width:980px;
    background:#fffffff2;backdrop-filter:blur(14px);border:1px solid var(--line);border-radius:999px;
    padding:0 10px 0 20px;box-shadow:0 6px 24px #17181c10;transition:box-shadow .3s}
  nav.sc .wrap{box-shadow:0 10px 34px #17181c1e}
  .brand{display:inline-flex;align-items:center}
  nav .links{margin-left:auto;display:flex;align-items:center;gap:20px;font-size:13px;font-weight:500}
  nav .links a{color:var(--dim);text-decoration:none;transition:color .15s}
  nav .links a:hover{color:var(--ink)}
  nav .gh{background:var(--ink);color:#f7f6f3!important;border-radius:999px;padding:9px 18px;font-weight:600;display:inline-flex;align-items:center;gap:6px}
  nav .gh:hover{background:#2b2c33}
  nav .lang{font:600 11.5px var(--mono);color:var(--rec)!important;border:1px solid #f0cdcd;border-radius:999px;padding:5px 11px}
  /* language menu */
  .lmenu{position:relative}
  .lmenu>summary{list-style:none;cursor:pointer;display:inline-flex;align-items:center;gap:5px;font:600 11.5px var(--mono);color:var(--rec);border:1px solid #f0cdcd;border-radius:999px;padding:5px 11px;user-select:none;transition:border-color .15s}
  .lmenu>summary::-webkit-details-marker{display:none}
  .lmenu>summary:hover{border-color:#e0b4b4}
  .lmenu[open]>summary{background:var(--rec-soft)}
  .lmenu>summary svg{color:var(--faint);transition:transform .2s}
  .lmenu[open]>summary svg{transform:rotate(180deg)}
  .lmenu-pop{position:absolute;top:calc(100% + 8px);right:0;min-width:148px;background:#fff;border:1px solid var(--line);border-radius:12px;padding:6px;box-shadow:0 14px 40px #17181c1c;display:flex;flex-direction:column;gap:2px;z-index:60}
  .lm{display:flex;align-items:center;gap:9px;padding:8px 11px;border-radius:8px;text-decoration:none;font-size:13px;font-weight:500;color:var(--ink)!important;transition:background .13s}
  .lm:hover{background:var(--warm)}
  .lm.cur{background:var(--rec-soft);color:var(--rec-ink)!important}
  .lmf{font:600 10px var(--mono);color:var(--faint);border:1px solid var(--line);border-radius:5px;padding:2px 5px;min-width:22px;text-align:center}
  .lm.cur .lmf{color:var(--rec);border-color:#f0cdcd}
  @media(max-width:700px){nav .links a:not(.gh):not(.lang){display:none}}

  /* ---------- timecode ruler — the brand motif ---------- */
  .ruler{height:26px;border-block:1px solid var(--line);position:relative;
    background:repeating-linear-gradient(90deg,var(--line2) 0 1px,transparent 1px 56px),
               repeating-linear-gradient(90deg,var(--line) 0 1px,transparent 1px 14px);
    background-position:0 100%,0 100%;background-size:auto 9px,auto 5px;background-repeat:repeat-x}
  .ruler i{position:absolute;top:-1px;bottom:-1px;width:2px;background:var(--rec);left:var(--x,30%)}
  .ruler i::after{content:"";position:absolute;top:-4px;left:-4px;width:8px;height:8px;border-radius:50%;background:var(--rec)}
  .ruler b{position:absolute;top:3px;font:500 10px var(--mono);color:var(--faint);letter-spacing:.06em}
  .ruler b.a{left:14px}.ruler b.b{right:14px}

  /* ---------- shared ---------- */
  .kicker{font:600 11px var(--mono);letter-spacing:.16em;color:var(--rec);text-transform:uppercase;margin-bottom:16px;display:flex;align-items:center;gap:9px}
  .kicker::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--rec)}
  .center .kicker{justify-content:center}
  section{padding:78px 0}
  .alt{background:var(--warm)}
  h2{font-size:clamp(28px,4vw,40px);font-weight:800;letter-spacing:-.025em;line-height:1.14;margin-bottom:16px}
  .lede{color:var(--dim);max-width:640px;font-size:16.5px}
  .center{text-align:center}.center .lede{margin:0 auto}
  .grid{display:grid;gap:14px;margin-top:44px}
  .g3{grid-template-columns:repeat(3,1fr)}
  .g2{grid-template-columns:repeat(2,1fr)}
  @media(max-width:760px){.g3,.g2{grid-template-columns:1fr}}

  .btn{display:inline-flex;align-items:center;gap:9px;text-decoration:none;font-size:14px;font-weight:600;padding:13px 26px;border-radius:999px;border:1px solid var(--line2);color:var(--ink);background:var(--panel);transition:all .18s}
  .btn .ar{transition:transform .18s}
  .btn:hover{border-color:#b9b6ac;transform:translateY(-1px);box-shadow:0 8px 20px #17181c10}
  .btn:hover .ar{transform:translateX(3px)}
  .btn.pri{background:var(--ink);color:#f7f6f3;border-color:var(--ink)}
  .btn.pri:hover{background:#2b2c33}
  .btn.acc{background:var(--rec);color:#fff;border-color:var(--rec)}
  .btn.acc:hover{background:var(--rec-ink)}

  .card{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:24px;transition:border-color .2s,box-shadow .2s,transform .2s}
  .card:hover{border-color:var(--line2);box-shadow:0 12px 32px #17181c0e;transform:translateY(-2px)}
  .card .ic{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:10px;background:var(--warm);border:1px solid var(--line);color:var(--ink);margin-bottom:14px}
  .card h3{font-size:15.5px;font-weight:700;margin-bottom:7px;letter-spacing:-.01em;display:flex;align-items:center;gap:8px}
  .card p{font-size:14px;color:var(--dim)}
  .card .n{font:600 10.5px var(--mono);color:var(--rec);display:block;margin-bottom:10px;letter-spacing:.1em}
  .card code{background:var(--warm);border:1px solid var(--line);border-radius:5px;padding:1px 6px;font-size:12.5px;color:var(--rec-ink)}

  /* evidence chips — icon+text tag system */
  .chip{display:inline-flex;align-items:center;gap:6px;font:600 10.5px var(--mono);letter-spacing:.06em;border-radius:6px;padding:3px 9px;border:1px solid transparent}
  .chip.rec{color:var(--rec);background:var(--rec-soft);border-color:#f2d4d4}
  .chip.ok{color:var(--ok);background:#e9f5ee;border-color:#d2e9db}
  .chip.amb{color:#a67c1a;background:#faf3e2;border-color:#efe0b8}
  .chip.inf{color:var(--info);background:#ebf1f9;border-color:#d4e0f0}
  .chip.dim{color:var(--dim);background:var(--warm);border-color:var(--line)}

  /* stats band */
  .stats{display:flex;flex-wrap:wrap;gap:0;justify-content:center;border-block:1px solid var(--line)}
  .stat{padding:26px 40px;text-align:center;border-left:1px solid var(--line)}
  .stat:first-child{border-left:0}
  .stat b{display:block;font:800 26px var(--sans);letter-spacing:-.02em}
  .stat span{font:500 10.5px var(--mono);letter-spacing:.12em;color:var(--faint);text-transform:uppercase}
  @media(max-width:700px){.stat{padding:18px 22px}.stat b{font-size:20px}}

  .term{background:var(--term);border-radius:var(--r);overflow:hidden;margin-top:40px;font:12.5px/1.85 var(--mono);border:1px solid var(--term-line);box-shadow:0 20px 50px #17181c1c}
  .term .th{display:flex;align-items:center;gap:7px;padding:11px 15px;border-bottom:1px solid var(--term-line);color:#77767f;font-size:11px}
  .term .th i{width:10px;height:10px;border-radius:50%;display:inline-block}
  .term .th i:nth-child(1){background:#e5484d}.term .th i:nth-child(2){background:#e2a93b}.term .th i:nth-child(3){background:#3d9d63}
  .term .th span{margin-left:8px}
  .term pre{padding:18px 20px;overflow-x:auto;color:var(--term-text)}
  .c-say{color:#8fb0f4}.c-ok{color:#6fce97}.c-bad{color:#f28b86}.c-dim{color:#6a6a75}.c-acc{color:#e8c476}.c-acc2{color:#d9a8ff}
</style>
</head>
<body>
<nav id="nav"><div class="wrap">
  <a href="/" class="brand" style="text-decoration:none"><Logo /></a>
  <div class="links">
    {nav.map(([href,label]) => <a href={href}>{label}</a>)}
    <details class="lmenu" id="lmenu">
      <summary><span class="lflag">{cur.flag}</span><svg width="9" height="9" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></summary>
      <div class="lmenu-pop">
        {LANGS.map(l => <a class={"lm" + (l.code === lang ? " cur" : "")} href={l.path}><span class="lmf">{l.flag}</span>{l.name}</a>)}
      </div>
    </details>
    <a class="gh" href={GH}>GitHub <span id="ghstars">★</span></a>
  </div>
</div></nav>

<slot />

<footer><div class="wrap">
  <div class="fgrid">
    <div class="fbrand">
      <a href={cur.path} class="brand" style="text-decoration:none"><Logo size={24}/></a>
      <p class="ftag">{f.tagline}</p>
      <p class="fmeta mono">{f.selfRec} <span class="frec">●</span></p>
    </div>
    {fcols.map(([h, links]) => (
      <div class="fcol"><h5>{h}</h5><ul>
        {links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
      </ul></div>
    ))}
  </div>
  <div class="fbot">
    <span>{f.copy}</span>
    <span class="mono">wit · witness.zalize.com</span>
  </div>
</div></footer>
<style>
  footer{padding:56px 0 44px;border-top:1px solid var(--line)}
  .fgrid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:32px}
  @media(max-width:760px){.fgrid{grid-template-columns:1fr 1fr}}
  .ftag{margin-top:16px;font-size:13px;color:var(--dim);line-height:1.7;max-width:300px}
  .fmeta{margin-top:14px;font-size:11px;color:var(--faint)}
  .frec{color:var(--rec);font-size:9px;vertical-align:1px}
  .fcol h5{font:600 11px var(--mono);letter-spacing:.14em;color:var(--faint);text-transform:uppercase;margin-bottom:14px}
  .fcol ul{list-style:none;padding:0;display:flex;flex-direction:column;gap:9px}
  .fcol a{color:var(--dim);text-decoration:none;font-size:13px;transition:color .15s}
  .fcol a:hover{color:var(--rec)}
  .fbot{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-top:36px;padding-top:18px;border-top:1px dashed var(--line);color:var(--faint);font-size:12px}
  .fbot .mono{font-family:var(--mono)}
</style>

<script>
  // Anonymous pageview ping — no cookies, no fingerprint, no PII.
  // Endpoint is our own Cloudflare Worker, not a third party.
  try {
    fetch("https://witness-stats.mxd79b86.workers.dev/e", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ e: "pv", b: [location.pathname, document.documentElement.lang || "", document.referrer ? new URL(document.referrer).hostname : "", ""], d: 1 }),
      keepalive: true,
    }).catch(() => {});
  } catch {}

  const nav = document.getElementById("nav");
  addEventListener("scroll", () => nav.classList.toggle("sc", scrollY > 8), { passive: true });
  const io = new IntersectionObserver(es => es.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add("on"); io.unobserve(e.target); }
  }), { threshold: .12 });
  document.querySelectorAll(".rv").forEach(el => {
    const d = el.getAttribute("data-d");
    if (d) el.style.transitionDelay = d + "ms";
    io.observe(el);
  });
  const lm = document.getElementById("lmenu");
  addEventListener("click", e => { if (lm?.open && !lm.contains(e.target as Node)) lm.open = false; });
  fetch("https://api.github.com/repos/wookat/witness").then(r => r.ok ? r.json() : null).then(d => {
    const el = document.getElementById("ghstars");
    const n = d && d.stargazers_count;
    if (el && typeof n === "number") el.textContent = "★ " + (n >= 1000 ? (n / 1000).toFixed(1) + "k" : n);
  }).catch(() => {});
</script>
</body>
</html>
